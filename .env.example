MEMORYIR_PROVIDER=mock
MEMORYIR_ENV=local
MEMORYIR_DATABASE_BACKEND=memory
DATABASE_URL=

AWS_REGION=us-east-1
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_AGENT_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_MAX_TOKENS=700

MCP_ENDPOINT=https://cockroachlabs.cloud/mcp
MCP_API_KEY=
MCP_CLUSTER_ID=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_TOP_K=5
FRONTEND_DIST=static
MEMORYIR_API_RATE_LIMIT=1.0
MEMORYIR_API_BURST_LIMIT=5
